{
  "name": "Taco",
  "private": true,
  "version": "0.5.1",
  "description": "Taco AI - 智能助手",
  "author": {
    "name": "Fushengfu",
    "email": "shengfu8161980541@qq.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fushengfu/tacoai.git"
  },
  "bugs": {
    "url": "https://github.com/Fushengfu/tacoai/issues"
  },
  "type": "module",
  "main": "dist-main/main.cjs",
  "scripts": {
    "postinstall": "node -e \"const f=require('fs'),p=process.platform,{execSync}=require('child_process');if(p==='win32'){for(const d of f.readdirSync('node_modules').filter(d=>d.startsWith('tree-sitter'))){const g='node_modules/'+d+'/binding.gyp';if(f.existsSync(g)){let c=f.readFileSync(g,'utf8');if(c.includes('/std:c++17')){f.writeFileSync(g,c.replace(/\\/std:c\\+\\+17/g,'/std:c++20'));console.log('[postinstall] patched '+g)}}}console.log('[postinstall] rebuilding node-pty for Electron...');try{execSync('npx @electron/rebuild -f -w node-pty',{stdio:'inherit'})}catch(e){console.error('[postinstall] electron-rebuild failed: '+e.message)}}else try{f.chmodSync('node_modules/node-pty/prebuilds/darwin-arm64/spawn-helper',0o755)}catch(e){}\"",
    "build:main": "esbuild src/main/main.ts --bundle --platform=node --format=cjs --minify --legal-comments=none --outfile=dist-main/main.cjs --external:electron --external:node-pty --external:tree-sitter --external:tree-sitter-typescript --external:tree-sitter-javascript --external:tree-sitter-python --external:tree-sitter-go --external:tree-sitter-rust --external:tree-sitter-c --external:tree-sitter-cpp --external:tree-sitter-java --external:tree-sitter-ruby --external:tree-sitter-php --external:tree-sitter-bash --external:tree-sitter-kotlin --external:tree-sitter-scala --external:tree-sitter-haskell --external:tree-sitter-elixir --external:tree-sitter-c-sharp --external:tree-sitter-perl --external:tree-sitter-css --external:tree-sitter-html --external:tree-sitter-json --external:tree-sitter-ocaml --external:tree-sitter-fsharp",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --minify --legal-comments=none --outfile=dist-preload/index.cjs --external:electron",
    "build:renderer": "vite build",
    "build:obfuscate:optional": "node scripts/obfuscate-optional.mjs",
    "dev": "npm run build:main && npm run build:preload && concurrently -k \"vite\" \"cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron dist-main/main.cjs\"",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer && npm run build:obfuscate:optional",
    "build:secure": "cross-env TACO_OBFUSCATE=1 npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "npm run build:main && npm run build:preload && npm run build:renderer && electron dist-main/main.cjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.taco.ai-agent",
    "productName": "Taco AI",
    "electronVersion": "40.1.0",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-main/**/*",
      "dist-preload/**/*",
      "build/icon.*",
      "node_modules/node-pty/**/*",
      "node_modules/tree-sitter/**/*",
      "node_modules/tree-sitter-typescript/**/*",
      "node_modules/tree-sitter-javascript/**/*",
      "node_modules/tree-sitter-python/**/*",
      "node_modules/tree-sitter-go/**/*",
      "node_modules/tree-sitter-rust/**/*",
      "node_modules/tree-sitter-c/**/*",
      "node_modules/tree-sitter-cpp/**/*",
      "node_modules/tree-sitter-java/**/*",
      "node_modules/tree-sitter-ruby/**/*",
      "node_modules/tree-sitter-php/**/*",
      "node_modules/tree-sitter-bash/**/*",
      "node_modules/tree-sitter-kotlin/**/*",
      "node_modules/tree-sitter-scala/**/*",
      "node_modules/tree-sitter-haskell/**/*",
      "node_modules/tree-sitter-elixir/**/*",
      "node_modules/tree-sitter-c-sharp/**/*",
      "node_modules/tree-sitter-perl/**/*",
      "node_modules/tree-sitter-css/**/*",
      "node_modules/tree-sitter-html/**/*",
      "node_modules/tree-sitter-json/**/*",
      "node_modules/tree-sitter-ocaml/**/*",
      "node_modules/tree-sitter-fsharp/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "asar": true,
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/tree-sitter/**/*",
      "node_modules/tree-sitter-typescript/**/*",
      "node_modules/tree-sitter-javascript/**/*",
      "node_modules/tree-sitter-python/**/*",
      "node_modules/tree-sitter-go/**/*",
      "node_modules/tree-sitter-rust/**/*",
      "node_modules/tree-sitter-c/**/*",
      "node_modules/tree-sitter-cpp/**/*",
      "node_modules/tree-sitter-java/**/*",
      "node_modules/tree-sitter-ruby/**/*",
      "node_modules/tree-sitter-php/**/*",
      "node_modules/tree-sitter-bash/**/*",
      "node_modules/tree-sitter-kotlin/**/*",
      "node_modules/tree-sitter-scala/**/*",
      "node_modules/tree-sitter-haskell/**/*",
      "node_modules/tree-sitter-elixir/**/*",
      "node_modules/tree-sitter-c-sharp/**/*",
      "node_modules/tree-sitter-perl/**/*",
      "node_modules/tree-sitter-css/**/*",
      "node_modules/tree-sitter-html/**/*",
      "node_modules/tree-sitter-json/**/*",
      "node_modules/tree-sitter-ocaml/**/*",
      "node_modules/tree-sitter-fsharp/**/*"
    ]
  },
  "overrides": {
    "tree-sitter-c": { "tree-sitter": "^0.25.0" },
    "tree-sitter-cpp": { "tree-sitter": "^0.25.0" },
    "tree-sitter-elixir": { "tree-sitter": "^0.25.0" },
    "tree-sitter-fsharp": { "tree-sitter": "^0.25.0" },
    "tree-sitter-haskell": { "tree-sitter": "^0.25.0" },
    "tree-sitter-html": { "tree-sitter": "^0.25.0" },
    "tree-sitter-java": { "tree-sitter": "^0.25.0" },
    "tree-sitter-json": { "tree-sitter": "^0.25.0" },
    "tree-sitter-kotlin": { "tree-sitter": "^0.25.0" },
    "tree-sitter-ocaml": { "tree-sitter": "^0.25.0" },
    "tree-sitter-perl": { "tree-sitter": "^0.25.0" },
    "tree-sitter-php": { "tree-sitter": "^0.25.0" },
    "tree-sitter-ruby": { "tree-sitter": "^0.25.0" },
    "tree-sitter-rust": { "tree-sitter": "^0.25.0" },
    "tree-sitter-scala": { "tree-sitter": "^0.25.0" },
    "tree-sitter-typescript": { "tree-sitter": "^0.25.0" }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@vscode/l10n": "^0.0.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dotenv": "^16.4.7",
    "highlight.js": "^11.11.1",
    "ignore": "^7.0.5",
    "isomorphic-git": "^1.38.5",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shell-quote": "^1.8.3",
    "tree-sitter": "^0.25.0",
    "tree-sitter-bash": "^0.25.1",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-c-sharp": "^0.23.5",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-css": "^0.25.0",
    "tree-sitter-elixir": "^0.3.5",
    "tree-sitter-fsharp": "^0.1.0",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-haskell": "^0.23.1",
    "tree-sitter-html": "^0.23.2",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-json": "^0.24.8",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-ocaml": "^0.24.2",
    "tree-sitter-perl": "^1.2.1",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-scala": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/shell-quote": "^1.7.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.10",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "40.1.0",
    "electron-builder": "^26.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vitest": "^4.1.10"
  }
}
